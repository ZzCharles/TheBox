{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "box",
  "main": "src/server/index.ts",
  // Must not exceed the date supported by the installed workerd binary, or
  // `vite dev` refuses to start. Bump alongside `npm update wrangler`.
  "compatibility_date": "2026-07-29",

  // `directory` is injected by @cloudflare/vite-plugin at build time.
  // The Worker must run FIRST for /parties/*, otherwise single-page-application
  // fallback would answer the WebSocket upgrade with index.html.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/parties/*"]
  },

  "durable_objects": {
    "bindings": [{ "name": "GameRoom", "class_name": "GameRoom" }]
  },

  // new_sqlite_classes (not new_classes) — SQLite-backed Durable Objects are the
  // ones available on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],

  "observability": { "enabled": true }
}
