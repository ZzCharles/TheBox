// Worker + shared. Runtime types come from worker-configuration.d.ts, which is
// regenerated by `npx wrangler types` whenever wrangler.jsonc changes.
{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [],

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/server", "src/shared", "worker-configuration.d.ts"],
  "exclude": ["src/**/*.test.ts"]
}
